@model GTiff2Tiles.Server.Models.Catalog

<div class="section-heading">
    <h2>Catalog imagery</h2>
    <span class="muted">All uploaded GeoTIFFs are served in order as one mosaic.</span>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
}

@{
    var orderedImages = Model.Images.OrderBy(image => image.SortOrder).ThenBy(image => image.Id).ToList();
}

@if (orderedImages.Count == 0)
{
    <p class="muted">No images yet. Upload GeoTIFFs to start serving tiles.</p>
}
else
{
    <article class="active-image">
        <h3>Mosaic order</h3>
        <p class="muted">Images higher in the list are drawn first. Move an image up or down to change how the mosaic is composed.</p>
    </article>
}

<h3>Uploads</h3>
@if (orderedImages.Count == 0)
{
    <p class="muted">No uploads for this catalog yet.</p>
}
else
{
    <div class="image-list">
        @for (int index = 0; index < orderedImages.Count; index++)
        {
            var image = orderedImages[index];
            bool canMoveUp = index > 0;
            bool canMoveDown = index < orderedImages.Count - 1;
            <article class="catalog-item">
                <div>
                    <p><strong>@image.OriginalFileName</strong></p>
                    <p class="muted">Uploaded @image.UploadedUtc.UtcDateTime.ToString("u")</p>
                    <p class="muted">@image.Width × @image.Height • @string.Format("{0:N0}", image.OriginalFileSizeBytes) bytes</p>
                    <p class="muted">Bounds: [@image.MinX, @image.MinY] → [@image.MaxX, @image.MaxY]</p>
                </div>
                <div class="catalog-item-actions">
                    <span class="badge">Layer @(index + 1)</span>
                    <form method="post"
                          hx-post="@Url.Page("/Catalogs/Details", "MoveImage", new { id = Model.Id, imageId = image.Id, offset = -1 })"
                          hx-target="#image-panel"
                          hx-swap="innerHTML">
                        <button type="submit" disabled="@(!canMoveUp)">Move up</button>
                    </form>
                    <form method="post"
                          hx-post="@Url.Page("/Catalogs/Details", "MoveImage", new { id = Model.Id, imageId = image.Id, offset = 1 })"
                          hx-target="#image-panel"
                          hx-swap="innerHTML">
                        <button type="submit" disabled="@(!canMoveDown)">Move down</button>
                    </form>
                    <form method="post"
                          hx-post="@Url.Page("/Catalogs/Details", "RemoveImage", new { id = Model.Id, imageId = image.Id })"
                          hx-target="#image-panel"
                          hx-swap="innerHTML"
                          onsubmit="return confirm('Remove this image from the catalog? The file will be permanently deleted.');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="button-link danger">Remove</button>
                    </form>
                </div>
            </article>
        }
    </div>
}
