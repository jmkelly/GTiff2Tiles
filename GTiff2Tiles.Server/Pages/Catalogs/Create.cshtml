@page
@model GTiff2Tiles.Server.Pages.Catalogs.CreateModel
@{
    ViewData["Title"] = "Create catalog";
}

<section class="card single-card create-card">
    <div class="section-heading">
        <div>
            <a asp-page="/Index">← Back to catalogs</a>
            <h1>Create catalog</h1>
            <p class="muted">Create a new catalog, then continue to the manage page to edit details and upload imagery.</p>
        </div>
    </div>

    <partial name="/Pages/_CreateCatalogForm.cshtml" model="Model.CreateCatalog" />
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
