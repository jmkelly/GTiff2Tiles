@model GTiff2Tiles.Server.Models.UploadGeoTiffInput

<form method="post"
      enctype="multipart/form-data"
      hx-post="@Url.Page("/Catalogs/Details", "Upload", new { id = ViewContext.RouteData.Values["id"] })"
      hx-target="#upload-form"
      hx-swap="innerHTML"
      hx-disabled-elt="find button">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

    <label asp-for="Files">GeoTIFF files</label>
    <input asp-for="Files" type="file" accept=".tif,.tiff,image/tiff" multiple />
    <span asp-validation-for="Files" class="validation-message"></span>

    <p class="muted">Uploads are normalized to EPSG:3857/Byte when needed. Every uploaded GeoTIFF is included in the catalog mosaic by default, and you can reorder the stack after upload.</p>

    <button type="submit">
        <span class="htmx-indicator" id="upload-spinner">
            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
            Uploading...
        </span>
        <span class="htmx-settling">Upload GeoTIFFs</span>
    </button>
</form>
