@model IReadOnlyList<GTiff2Tiles.Server.Models.Catalog>

@if (Model.Count == 0)
{
    <p class="muted">No catalogs yet.</p>
}
else
{
    <div class="catalog-list">
        @foreach (var catalog in Model)
        {
            <article class="catalog-item">
                <div>
                    <h3>@catalog.Name</h3>
                    <p><code>/@catalog.Slug/{z}/{x}/{y}</code></p>
                    @if (!string.IsNullOrWhiteSpace(catalog.Description))
                    {
                        <p class="muted">@catalog.Description</p>
                    }
                    <p class="muted">Images: @catalog.ImageCount</p>
                </div>
                <div class="catalog-actions">
                    <a class="button-link" asp-page="/Catalogs/Details" asp-route-id="@catalog.Id">Manage</a>
                    @if (catalog.ImageCount > 0)
                    {
                        <a class="button-link secondary" asp-page="/Catalogs/Map" asp-route-id="@catalog.Id">View map</a>
                    }
                    <form hx-post="@Url.Page("/Index", "Delete", new { id = catalog.Id })"
                          hx-target="#catalog-list"
                          hx-swap="innerHTML"
                          onsubmit="return confirm('Delete this catalog and all uploaded imagery?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="button-link danger">Delete</button>
                    </form>
                </div>
            </article>
        }
    </div>
}
