@page
@model GTiff2Tiles.Server.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Catalog Admin";
}

<div class="coord-bar">
    <span>Dashboard</span>
    <span>&mdash;</span>
    <span>Catalog Registry</span>
</div>

<section class="card single-card">
    <div class="section-heading">
        <div>
            <h1>Catalog admin</h1>
            <p class="muted">Create catalogs, manage catalog details, upload GeoTIFFs, and serve XYZ tiles from the active raster in each catalog.</p>
        </div>

        <div class="page-actions">
            <a class="button-link secondary" asp-page="/Admin/Settings">Settings</a>
            <a class="button-link" asp-page="/Admin/Catalogs/Create">+ New catalog</a>
        </div>
    </div>

    <div class="divider"></div>

    <div id="catalog-list"
         hx-get="@Url.Page("/Admin/Index", "CatalogList")"
         hx-trigger="load"
         hx-swap="innerHTML">
    </div>
</section>
