@page
@model GTiff2Tiles.Server.Pages.IndexModel
@{
    ViewData["Title"] = "Catalog Admin";
}

<section class="card single-card">
    <div class="section-heading">
        <div>
            <h1>Catalog admin</h1>
            <p class="muted">Create catalogs, manage catalog details, upload GeoTIFFs, and serve XYZ tiles from the active raster in each catalog.</p>
        </div>

        <a class="button-link" asp-page="/Catalogs/Create">Create catalog</a>
    </div>

    <div id="catalog-list"
         hx-get="@Url.Page("/Index", "CatalogList")"
         hx-trigger="load"
         hx-swap="innerHTML">
    </div>
</section>
